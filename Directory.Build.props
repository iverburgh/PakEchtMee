<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Required for IDE0005 (unnecessary usings) to run during build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: XML docs are written where they add value, not everywhere.
         CA1716: "Shared" is a VB keyword; the namespace convention is fixed by the project layout.
         CA1848: LoggerMessage source generation is not worth the ceremony at this scale. -->
    <NoWarn>$(NoWarn);CS1591;CA1716;CA1848</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
