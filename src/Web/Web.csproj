<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>pakechtmee-web</UserSecretsId>
  </PropertyGroup>

  <!--
    `dotnet publish -t:PublishContainer` builds the production image with the SDK's container support, so the API needs
    no Dockerfile. The default aspnet base image runs as the non-root `app` user and listens on port 8080. The pipeline
    sets ContainerRegistry and ContainerImageTag; without a registry the image goes to the local Docker daemon.
  -->
  <PropertyGroup>
    <ContainerRepository>pakechtmee-api</ContainerRepository>
    <ContainerImageTag>local</ContainerImageTag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- SqlClient 7 ships Entra ID authentication separately; production signs in to Azure SQL with a managed identity. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\Catalog\Catalog.Infrastructure.Sql\Catalog.Infrastructure.Sql.csproj" />
    <ProjectReference Include="..\Families\Families.Application\Families.Application.csproj" />
    <ProjectReference Include="..\Families\Families.Infrastructure.Sql\Families.Infrastructure.Sql.csproj" />
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\Trips\Trips.Application\Trips.Application.csproj" />
    <ProjectReference Include="..\Trips\Trips.Infrastructure.Sql\Trips.Infrastructure.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Web.Tests" />
  </ItemGroup>

</Project>
